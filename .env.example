# SpendWise Environment Configuration

# MongoDB connection string (Optional for local testing - SpendWise has an automatic resilient persistence layer with initial demo dataset if omitted)
# For production or MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise?retryWrites=true&w=majority

# App environment
APP_ENV=development

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
